# Backend environment variables
# Set these values in the server environment or backend/.env.

# Felcloud credentials are server-side only. Do not add them to a VITE_ variable.
FELCLOUD_API_KEY=
FELCLOUD_BASE_URL=https://llm.felcloud.io/v1
# Set model IDs from the backend's /llm/models response.
FELCLOUD_COMPACT_MODEL=
FELCLOUD_MIDSIZE_MODEL=
# Optional if the compact model does not support image input.
FELCLOUD_VISION_MODEL=
