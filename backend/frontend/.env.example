# Public environment variables for the frontend build
# Replace placeholder values in your local .env file or Vercel project settings.
# Local Vite proxy targets: Laravel app API/auth and FastAPI AI/media routes.
VITE_API_URL=http://localhost:8001
VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE=/api
# Felcloud credentials, base URL, and model IDs belong in backend/.env.
