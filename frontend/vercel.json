{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/llm/:path*",
      "destination": "https://amplify-ednova-fastapi.vercel.app/llm/:path*"
    },
    {
      "source": "/llm",
      "destination": "https://amplify-ednova-fastapi.vercel.app/llm"
    },
    {
      "source": "/turn",
      "destination": "https://amplify-ednova-fastapi.vercel.app/turn"
    },
    {
      "source": "/generate",
      "destination": "https://amplify-ednova-fastapi.vercel.app/generate"
    },
    {
      "source": "/research/:path*",
      "destination": "https://amplify-ednova-fastapi.vercel.app/research/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "https://amplify-ednova-fastapi.vercel.app/videos/:path*"
    },
    {
      "source": "/neo4j/:path*",
      "destination": "https://amplify-ednova-fastapi.vercel.app/neo4j/:path*"
    },
    {
      "source": "/neo4j",
      "destination": "https://amplify-ednova-fastapi.vercel.app/neo4j"
    },
    {
      "source": "/biology/:path*",
      "destination": "https://amplify-ednova-fastapi.vercel.app/biology/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://amplify-ednova-fastapi.vercel.app/api/:path*"
    }
  ]
}

